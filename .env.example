# Copia este fichero como .env (no se sube a git) y rellena lo que necesites.

# "sample" = liga de ejemplo (por defecto) · "live" = LaLiga real
DATA_SOURCE=live

# Clave de https://the-odds-api.com (plan gratis: 500 créditos/mes). Sin clave, las cuotas salen
# del fichero gratuito de football-data.co.uk, que se actualiza un par de veces por semana.
ODDS_API_KEY=

# Opcional
# ODDS_REGIONS=eu                     # casas de apuestas europeas (eu, uk, us, au)
# ODDS_MARKETS=h2h,totals             # añadir mercados gasta más créditos por consulta
# ODDS_MIN_INTERVAL_MINUTES=5         # nunca consultar cuotas más a menudo que esto
# FALLBACK_ODDS_INTERVAL_MINUTES=360  # cuotas sin clave (football-data.co.uk)
# RESULTS_INTERVAL_MINUTES=360        # resultados de football-data.co.uk
# SCORES_INTERVAL_MINUTES=720         # resultados recientes de The Odds API
# HISTORY_SEASONS=3                   # temporadas de histórico para entrenar
